<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Patrón de kiwis: se repite para llenar la pantalla, no se estira -->
    <item>
        <bitmap
            android:src="@drawable/patron_kiwi"
            android:tileMode="repeat" />
    </item>

    <!-- Velo crema semitransparente para que los textos se lean bien -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/fondo_velo" />
        </shape>
    </item>
</layer-list>
<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fondo_patron_kiwi">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Encabezado negro -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/color_encabezado"
            android:minHeight="@dimen/alto_barra_principal"
            app:title="@string/titulo_main"
            app:subtitle="@string/subtitulo_main"
            app:titleTextAppearance="@style/TextAppearance.Material3.TitleLarge"
            app:titleTextColor="@color/texto_encabezado"
            app:subtitleTextColor="@color/subtitulo_encabezado" />

        <!-- Filtros -->
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupFiltros"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/separacion_amplia"
            android:paddingTop="@dimen/separacion_normal"
            app:selectionRequired="true"
            app:singleLine="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipTodos"
                style="@style/Chip.Filtro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/filtro_todos" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipCumpleanos"
                style="@style/Chip.Filtro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/filtro_cumpleanos" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipEvento"
                style="@style/Chip.Filtro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/filtro_evento" />
        </com.google.android.material.chip.ChipGroup>

        <!-- Lista + mensaje de lista vacía -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerEventos"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingHorizontal="@dimen/separacion_amplia"
                android:paddingTop="@dimen/separacion_normal"
                android:paddingBottom="@dimen/lista_padding_inferior" />

            <TextView
                android:id="@+id/txtVacio"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:padding="@dimen/separacion_maxima"
                android:text="@string/lista_vacia"
                android:textColor="@color/texto_secundario"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <!-- Botón flotante mostaza -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabNuevaAnotacion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/separacion_muy_amplia"
        android:text="@string/nueva_anotacion"
        android:textColor="@color/texto_sobre_acento"
        app:backgroundTint="@color/color_acento" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
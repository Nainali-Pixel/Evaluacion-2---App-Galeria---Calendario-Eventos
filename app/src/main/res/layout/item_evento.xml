<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/separacion_media"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/superficie"
    app:cardCornerRadius="@dimen/radio_mediano"
    app:cardElevation="@dimen/sin_elevacion"
    app:strokeWidth="@dimen/sin_borde">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/separacion_normal">

        <!-- Cuadrito: foto del usuario o imagen predeterminada del tipo -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardMiniatura"
            android:layout_width="@dimen/miniatura_tamano"
            android:layout_height="@dimen/miniatura_tamano"
            app:cardCornerRadius="@dimen/radio_pequeno"
            app:cardElevation="@dimen/sin_elevacion"
            app:strokeWidth="@dimen/sin_borde">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:id="@+id/imgMiniatura"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/desc_miniatura"
                    android:scaleType="centerCrop" />

                <TextView
                    android:id="@+id/txtMiniatura"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="@string/imagen_predeterminada"
                    android:textColor="@color/white"
                    android:textSize="@dimen/texto_miniatura" />
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Textos a la derecha -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/separacion_intermedia"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtTitulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/texto_principal"
                android:textSize="@dimen/texto_subtitulo"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtFechaHora"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/separacion_minima"
                android:textColor="@color/texto_secundario"
                android:textSize="@dimen/texto_etiqueta" />

            <TextView
                android:id="@+id/txtTipo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/separacion_muy_chica"
                android:letterSpacing="0.05"
                android:textAllCaps="true"
                android:textSize="@dimen/texto_pequeno"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>